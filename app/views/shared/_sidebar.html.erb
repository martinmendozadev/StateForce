<div class="relative flex grow flex-col gap-y-5 overflow-y-auto border-r border-gray-200 bg-white px-4 py-4 dark:border-white/10 dark:bg-gray-900 dark:before:pointer-events-none dark:before:absolute dark:before:inset-0 dark:before:bg-black/10">
  <div class="relative flex h-16 shrink-0 items-center">
    <%= link_to root_path, class: "p-2" do %>
      <%= cdn_image :logo_white, class: "h-12", alt: t("landing.company_name") %>
    <% end %>
  </div>
  <nav class="relative flex flex-1 flex-col" aria-label="Sidebar">
    <ul role="list" class="flex flex-1 flex-col gap-y-6">
      <li>
        <ul role="list" class="-mx-2 space-y-1">
          <li>
            <%= link_to "Dashboard", "#", class: "block rounded-md bg-gray-50 py-2 pr-2 pl-4 text-sm font-semibold text-gray-700 dark:bg-white/5 dark:text-gray-300" %>
          </li>

          <li class="pt-2">
            <p class="px-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Operaciones</p>
            <button type="button" command="--toggle" commandfor="submenu-events" class="mt-1 flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">
              <%= svg_icon :arrow_right, class: "h-5", alt: "Toggle" %>
              Eventos
            </button>
            <el-disclosure id="submenu-events" hidden class="contents">
              <ul class="mt-1 px-2">
                <li><%= link_to "Eventos", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Transferencias de Pacientes", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Agenda", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
              </ul>
            </el-disclosure>
          </li>

          <li class="pt-2">
            <p class="px-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Pacientes</p>
            <button type="button" command="--toggle" commandfor="submenu-patients" class="mt-1 flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">
              <%= svg_icon :arrow_right, class: "h-5", alt: "Toggle" %>
              Gestión de Pacientes
            </button>
            <el-disclosure id="submenu-patients" hidden class="contents">
              <ul class="mt-1 px-2">
                <li><%= link_to "Pacientes", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Constantes/Signos Vitales", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Notas Clínicas", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
              </ul>
            </el-disclosure>
          </li>

          <li class="pt-2">
            <p class="px-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Recursos</p>
            <button type="button" command="--toggle" commandfor="submenu-resources" class="mt-1 flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">
              <%= svg_icon :arrow_right, class: "h-5", alt: "Toggle" %>
              Recursos
            </button>
            <el-disclosure id="submenu-resources" hidden class="contents">
              <ul class="mt-1 px-2">
                <li><%= link_to "Recursos", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Tipos de Recurso", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Categorías de Recurso", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
              </ul>
            </el-disclosure>
          </li>

          <li class="pt-2">
            <p class="px-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Instituciones y Unidades</p>
            <button type="button" command="--toggle" commandfor="submenu-institutions" class="mt-1 flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">
              <%= svg_icon :arrow_right, class: "h-5", alt: "Toggle" %>
              Instituciones
            </button>
            <el-disclosure id="submenu-institutions" hidden class="contents">
              <ul class="mt-1 px-2">
                <li><%= link_to "Instituciones", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Unidades Operativas", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Camas y Quirófanos", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
              </ul>
            </el-disclosure>
          </li>

          <li class="pt-2">
            <p class="px-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Notas y Archivos</p>
            <button type="button" command="--toggle" commandfor="submenu-notes" class="mt-1 flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">
              <%= svg_icon :arrow_right, class: "h-5", alt: "Toggle" %>
              Documentos
            </button>
            <el-disclosure id="submenu-notes" hidden class="contents">
              <ul class="mt-1 px-2">
                <li><%= link_to "Notas", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Adjuntos", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
              </ul>
            </el-disclosure>
          </li>

          <li class="pt-2">
            <p class="px-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Usuarios</p>
            <button type="button" command="--toggle" commandfor="submenu-users" class="mt-1 flex w-full items-center gap-x-3 rounded-md p-2 text-left text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5">
              <%= svg_icon :arrow_right, class: "h-5", alt: "Toggle" %>
              Personas
            </button>
            <el-disclosure id="submenu-users" hidden class="contents">
              <ul class="mt-1 px-2">
                <li><%= link_to "Usuarios", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Contactos", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
                <li><%= link_to "Invitaciones", "#", class: "block rounded-md py-2 pr-2 pl-6 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %></li>
              </ul>
            </el-disclosure>
          </li>

          <li class="pt-2">
            <p class="px-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Auditoría</p>
            <%= link_to "Bitácora de Auditoría", "#", class: "mt-1 block rounded-md py-2 pr-2 pl-4 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %>
          </li>

          <li class="pt-2">
            <p class="px-2 text-xs font-semibold text-gray-500 dark:text-gray-400">Otras</p>
            <%= link_to "Calendario", "#", class: "mt-1 block rounded-md py-2 pr-2 pl-4 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %>
            <%= link_to "Ajustes", "#", class: "mt-1 block rounded-md py-2 pr-2 pl-4 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-white/5" %>
          </li>
        </ul>
      </li>

      <li class="-mx-4 mt-auto">
        <%= link_to "#", class: "flex items-center gap-3 rounded-md p-3 hover:bg-gray-50 dark:hover:bg-white/5" do %>
          <%= cdn_image current_user&.avatar&.url, class: "h-10 w-10 rounded-full object-cover", alt: current_user&.name %>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-gray-900 dark:text-gray-100"><%= current_user&.name || "Usuario" %></p>
            <p class="truncate text-xs text-gray-500 dark:text-gray-400"><%= current_user&.email %></p>
          </div>
        <% end %>
      </li>
    </ul>
  </nav>
</div>
