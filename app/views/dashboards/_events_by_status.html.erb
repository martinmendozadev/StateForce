<% total_events = @events_by_status.values.sum.to_f %>

<% tailwind_colors = {
  "info"      => "oklch(0.60 0.23 255)",
  "success"   => "oklch(0.62 0.23 145)",
  "warning"   => "oklch(0.70 0.26 40)",
  "secondary" => "oklch(0.57 0.21 325)",
  "primary"   => "oklch(0.45 0.19 275)",
  "neutral"   => "oklch(0.50 0.01 261.692)"
} %>

<% status_colors = {
  "assigned" => "info",
  "resolved" => "success",
  "pending"  => "warning",
  "on_scene" => "secondary",
  "closed"   => "primary",
  "other"    => "neutral"
} %>

<% current_position = 0 %>
<% gradient_segments = [] %>

<% @events_by_status.each do |status, count| %>
  <% percent = (count / total_events) * 100 %>

  <% color_key   = status_colors[status] || "neutral" %>
  <% color_value = tailwind_colors[color_key] %>

  <% gradient_segments << "#{color_value} #{current_position}% #{current_position + percent}%" %>

  <% current_position += percent %>
<% end %>

<% gradient_css = gradient_segments.join(", ") %>

<div class="bg-background-emphasis p-4 rounded-xl flex flex-col gap-8 ">
  <h1 class="text-xl font-semibold"><%= t(".title") %></h1>

  <div class="flex gap-8 items-center">

    <div class="flex flex-col gap-2 text-sm text-foreground">
      <% @events_by_status.each do |status, count| %>
        <% color = status_colors[status] || "neutral" %>

        <div class="flex items-center gap-2">
          <div class="flex-none rounded-full bg-<%= color %>/10 p-1 text-<%= color %> max-w-4">
            <div class="size-2 rounded-full bg-current"></div>
          </div>
          <span><%= status.humanize %> (<%= count %>)</span>
        </div>
      <% end %>
    </div>

    <div class="relative size-42">
      <div class="size-full rounded-full"
        style="background: conic-gradient(<%= gradient_css %>);">
      </div>

      <div class="absolute inset-6 bg-background-emphasis rounded-full flex flex-col items-center justify-center">
        <span class="text-lg font-semibold"><%= total_events.to_i %> <%= t(".heading") %></span>
        <span class="text-xs text-gray-400"><%= t(".sub_title") %></span>
      </div>
    </div>
  </div>
</div>
