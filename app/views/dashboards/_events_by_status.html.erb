<div class="bg-background-emphasis p-4 rounded-xl flex flex-col gap-8 items-center">
  <h1 class="text-xl font-semibold"><%= t(".title") %></h1>

  <div class="flex gap-8 items-center">
    <div class="flex flex-col gap-2">
      <% Event.statuses.each do |status, _| %>
        <div class="text-sm font-medium text-foreground">
          <div class="flex items-center gap-2">
            <% case status %>
              <% when Event.statuses[:assigned] %>
                <div class="flex-none rounded-full bg-info/10 p-1 text-info max-w-4">
                  <div class="size-2 rounded-full bg-current"></div>
                </div>
              <% when Event.statuses[:resolved] %>
                <div class="flex-none rounded-full bg-success/10 p-1 text-success max-w-4">
                  <div class="size-2 rounded-full bg-current"></div>
                </div>
              <% when Event.statuses[:pending] %>
                <div class="flex-none rounded-full bg-warning/10 p-1 text-warning max-w-4">
                  <div class="size-2 rounded-full bg-current"></div>
                </div>
              <% when Event.statuses[:on_scene] %>
                <div class="flex-none rounded-full bg-secondary/10 p-1 text-secondary max-w-4">
                  <div class="size-2 rounded-full bg-current"></div>
                </div>
              <% when Event.statuses[:closed] %>
                <div class="flex-none rounded-full bg-primary/10 p-1 text-primary max-w-4">
                  <div class="size-2 rounded-full bg-current"></div>
                </div>
              <% else %>
                <div class="flex-none rounded-full bg-neutral/10 p-1 text-neutral-500 max-w-4">
                  <div class="size-2 rounded-full bg-current"></div>
                </div>
              <% end %>

            <span class="sm:hidden block text-xs text-gray-500"><%= t('.event_status') %>:</span>
            <span class="block"><%= status.humanize %></span>
          </div>
        </div>
      <% end %>
    </div>

    <div class="relative w-48 h-48">
      <div class="absolute inset-0 rounded-full border-24 border-transparent"
         style="
           border-top-color: #3b82f6;
           border-right-color: #ef4444;
           border-bottom-color: #fbbf24;
           border-left-color: #2dd4bf;
           transform: rotate(20deg); /* opcional */
         ">
      </div>

      <div class="absolute inset-6 bg-background-emphasis rounded-full flex flex-col items-center justify-center">
        <span class="text-lg font-semibold"><%= t(".percentage") %></span>
        <span class="text-xs text-gray-400"><%= t(".events") %></span>
      </div>
    </div>
  </div>
</div>
