<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "StateForce" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href=<%= CDN_IMAGES[:favicon] %> type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script>
  </head>
  <body>
    <main class="isolate relative">
      <%= render "shared/flash" %>
      <%= render "shared/base_layout" %>
    </main>
    <!-- Grid Background -->
    <%= svg_icon :square_background,
      class: "fixed inset-0 -z-10 w-full h-full stroke-background-emphasis [mask-image:radial-gradient(32rem_32rem_at_center,white,transparent)]",
      title: "Background" %>
    <div class="absolute left-1/2 right-0 top-0 -z-10 -ml-24 transform-gpu overflow-hidden blur-3xl lg:ml-24 xl:ml-48" aria-hidden="true">
      <div
          class="aspect-[801/1036] bg-gradient-to-tr from-secondary-disabled to-primary-focus opacity-30"
          style="clip-path: polygon(63.1% 29.5%, 100% 17.1%, 76.6% 3%, 48.4% 0%, 44.6% 4.7%, 54.5% 25.3%, 59.8% 49%, 55.2% 57.8%, 44.4% 57.2%, 27.8% 47.9%, 35.1% 81.5%, 0% 97.7%, 39.2% 100%, 35.2% 81.4%, 97.2% 52.8%, 63.1% 29.5%)">
      </div>
    </div>
    <!-- End Grid Background -->
    <%= javascript_include_tag "flash_messages", "data-turbo-track": "reload" %>
  </body>
</html>
